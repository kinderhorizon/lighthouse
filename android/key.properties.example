# Template for android/key.properties (Git-ignored)
#
# INSTRUCTIONS:
# 1. Copy this file to android/key.properties:
#    cp android/key.properties.example android/key.properties
# 2. Fill in the path to your release/upload keystore and credentials.
# 3. NEVER commit android/key.properties or your .jks file to Git!
#
# storeFile can be an absolute path or a path relative to the android/ directory.
storeFile=upload-keystore.jks
storePassword=YOUR_KEYSTORE_PASSWORD_HERE
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD_HERE
