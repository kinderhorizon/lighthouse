<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>es</string>
		<string>ar</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Lighthouse AAC</string>
	<!-- Open a shared board file with Lighthouse (ADR 0015 amendment): AirDrop,
	     Messages, Mail, Files and WhatsApp list Lighthouse under "Open in" /
	     the share sheet. Without this the phone offered the .json file only to
	     other apps, which asked the parent to sign in. Alternate rank: Lighthouse
	     is never the default app for every JSON file. The file is copied to tmp
	     and the parent confirms behind the math gate before anything is
	     imported (IncomingFilePlugin in AppDelegate.swift). -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Lighthouse board</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.json</string>
			</array>
		</dict>
	</array>
	<!-- iOS hands the app a private copy of the file (in Documents/Inbox, which
	     IncomingFilePlugin deletes at once) instead of the original. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<!-- Lighthouse has no deep links. Flutter turns them on by default, and
	     would then try to open the board file's address as a screen and fail. -->
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>lighthouse</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>FlutterSceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- The app uses only standard, exempt encryption (HTTPS for build-time
	     asset downloads; nothing at runtime, fully offline per ADR 0002).
	     Declaring this avoids the export-compliance prompt on every TestFlight
	     and App Store upload. Revisit only if non-exempt crypto is added. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- No photo/camera/location usage strings: custom-button photos use the
	     system photo picker (PHPicker, image_picker) and pack import uses the
	     document picker (file_selector). Neither links the Photos, Camera, or
	     CoreLocation frameworks, so no purpose string is required (ADR 0016). -->
	<!-- Microphone: the parent (behind the math gate) may record a short custom
	     voice clip for a tile (ADR 0019). The recording stays on the device and
	     is never transmitted (disclosed on kinderhorizon.org/lighthouse/privacy).
	     A child cannot start a recording. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Record a short custom voice for a button. The recording stays on this device and is never sent anywhere.</string>
</dict>
</plist>
